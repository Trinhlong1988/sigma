# SigMa bot-api — mẫu biến môi trường. Copy thành .env cùng thư mục (KHÔNG commit .env thật — đã có
# trong .gitignore root: ".env" + ".env.*" trừ "!.env.example").

# Postgres — DB RIÊNG của SigMa, TÁCH ĐỘC LẬP hoàn toàn khỏi `glb` (quyết định Admin Demo 24/7: dự án mới hoàn
# toàn, dữ liệu trống, chỉ dựng giả để nghiệm thu, KHÔNG dùng chung bất kỳ gì với GLB). Trên máy chủ chung
# 127.0.0.1 (chạy CẢ GLB lẫn SigMa) BẮT BUỘC DB tên `sigma`, KHÔNG bao giờ `glb`.
DATABASE_URL=postgresql://postgres:<DIEN_VAO>@localhost:5432/sigma

# (Tùy chọn, CHỈ cho test suite bot-api — apps/bot-api/test/global-setup.ts) Thư mục chứa binary Postgres 16
# (createdb/dropdb/pg_dump). Mặc định <PG_BIN>/pgsql/bin. Biến RIÊNG của SigMa (SIGMA_*), KHÔNG đọc
# biến GLB_* của dự án GLB trên cùng máy. Test tự tạo DB throwaway tên `alpha_botapi_test_<timestamp>` rồi tự xóa.
# SIGMA_PG_BIN=<PG_BIN>/pgsql/bin

# Gmail SMTP gửi OTP đăng ký (nodemailer, smtp.gmail.com:465 secure). OTP_SMTP_APP_PASSWORD là "App Password"
# 16 ký tự tạo ở Google Account → Security → App Passwords (KHÔNG phải mật khẩu Gmail thường — tài khoản phải
# bật 2FA trước mới tạo được App Password). Điền App Password thật ở .env thật, KHÔNG commit .env thật.
OTP_SMTP_USER=<DIEN_VAO>
OTP_SMTP_APP_PASSWORD=

# Rocket.Chat server thật.
RC_BASE_URL=https://chat.example.com

# Admin Rocket.Chat để gọi users.create khi đăng ký tài khoản mới (rc-client.ts) — ƯU TIÊN dùng
# RC_ADMIN_AUTH_TOKEN/RC_ADMIN_USER_ID (Personal Access Token tạo sẵn trong RC Admin, không lo hết hạn giữa
# chừng). Nếu để trống, rc-client.ts fallback login bằng RC_ADMIN_USERNAME/RC_ADMIN_PASSWORD rồi tự cache
# token trong bộ nhớ tiến trình.
RC_ADMIN_AUTH_TOKEN=
RC_ADMIN_USER_ID=
RC_ADMIN_USERNAME=
RC_ADMIN_PASSWORD=

# 25/7 — PHẢI khớp CHÍNH XÁC với CREATE_TOKENS_FOR_USERS_SECRET đặt trên container Rocket.Chat (docker-compose.yml
# của sigma-rocketchat). Dùng để cấp thẳng session cho user vừa admin tạo (POST /api/v1/users.createToken),
# bỏ qua bước đăng nhập-bằng-mật-khẩu nên KHÔNG bị RC bắt 2FA-qua-email lần 2 khi đăng ký (xem rc-client.ts
# rcCreateLoginTokenForUser + routes/auth.ts verify-otp).
RC_CREATE_TOKEN_SECRET=

# SIGMA (26/7) — Push notification kieu Zalo qua Firebase Cloud Messaging (FCM). Duong dan KETOAN DOI toi
# file service-account key that cua Firebase project sigma-demo-project (Admin SDK) -- KHONG BAO GIO commit
# noi dung file nay, chi commit duong dan placeholder o day. File that nam ngoai git (secrets/ da gitignore).
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/apps/bot-api/secrets/firebase-service-account.json

# Shared secret bot-api tu sinh, dat GIONG HET trong URL webhook cau hinh o Rocket.Chat Admin > Integrations
# (outgoing webhook "sigma-push-notify", xem scripts/ensure-rc-webhook-integration.mjs) -- xac minh
# POST /v1/rc-events/message that su den tu RC, khong phai nguon gia mao goi thang vao endpoint noi bo.
RC_WEBHOOK_SECRET=

# SIGMA (27/7) -- thu muc luu file dinh kem chat that (anh/file), duong dan TUONG DOI so voi apps/bot-api
# (khac FIREBASE_SERVICE_ACCOUNT_PATH o tren, khong bat buoc tuyet doi). Xem chat-attachment-service.ts. Thu
# muc nay PHAI nam ngoai git (da them .gitignore rieng) -- chua du lieu nguoi dung that.
CHAT_UPLOADS_DIR=./uploads/chat

# SIGMA Phase 1 "bo Rocket.Chat" (28/7) -- Dang nhap Google OAuth THAT (Google Identity Services, luong
# verify ID token phia server qua google-auth-library, KHONG can Client Secret). Tao Client ID tai Google
# Cloud Console > APIs & Services > Credentials > OAuth client ID (loai "Web application"). PHAI khop CHINH
# XAC voi VITE_GOOGLE_CLIENT_ID o apps/web-demo/.env (cung 1 gia tri dung ca 2 phia -- server verify dung
# "audience"). Xem google-oauth-service.ts.
GOOGLE_CLIENT_ID=

# SIGMA (1/8, muc 32 "Sao luu, dong bo") -- OAuth Authorization Code flow de ket noi Google Drive CA NHAN
# cua tung dai ly (xin scope drive.file, KHONG doc duoc Drive con lai cua ho) -- HOAN TOAN KHAC luong dang nhap
# GOOGLE_CLIENT_ID o tren (ID-token thuan, khong xin quyen gi). Tao Client Secret cho CUNG 1 OAuth Client "Web
# application" da co (Google Cloud Console > APIs & Services > Credentials > mo Client ID dang dung cho
# GOOGLE_CLIENT_ID > tao/xem Client Secret) -- KHONG tao Client ID moi. BAT BUOC bat THEM "Google Drive API"
# (APIs & Services > Library > Google Drive API > Enable) cho project truoc khi dung duoc. Xem drive-backup-
# service.ts.
GOOGLE_CLIENT_SECRET=

# Khoa ma hoa doi xung (AES-256-GCM) de luu refresh_token Google Drive cua dai ly (GIAI MA LAI DUOC de goi Drive
# API nhieu lan -- KHAC bcrypt passwordHash 1 chieu). BAT BUOC dung 32 byte ma hoa base64 -- sinh 1 lan qua:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# GIU CO DINH sau khi da co du lieu that (doi khoa nay se khien MOI refresh_token da luu KHONG giai ma lai duoc
# -- dai ly phai ket noi lai Google Drive tu dau). Xem drive-backup-service.ts encryptRefreshToken()/
# decryptRefreshToken().
DRIVE_TOKEN_ENC_KEY=
