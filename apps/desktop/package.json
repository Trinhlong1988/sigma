{
  "name": "@sigma/desktop",
  "version": "0.2.187",
  "private": true,
  "description": "SigMa — Electron desktop app (rebrand clone of Quản Lý GLB; G1 Phase A: login → force change password → dashboard).",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "predist": "node scripts/ensure-config-default.mjs",
    "dist": "electron-vite build && electron-builder --win",
    "build:web": "tsc --noEmit -p tsconfig.web.json && vite build --config vite.config.web.ts && node scripts/kiem-css-web.mjs",
    "preview:web": "vite preview --config vite.config.web.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:tn": "electron-vite build && electron-builder --win --config electron-builder.alphatn.yml"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.1.0",
    "@sigma/business-rules": "*",
    "@sigma/database": "*",
    "@sigma/services": "*",
    "@sigma/shared": "*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "electron-updater": "^6.6.2",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.462.0",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "tailwindcss": "^4.0.0",
    "vite": "^5.4.11"
  }
}
