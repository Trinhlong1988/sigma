# Base URL của bot-api thật (apps/bot-api) — dùng cho lib/bot-api-client.ts.
# Mặc định khi KHÔNG set biến này: http://localhost:8788 (xem apps/bot-api/package.json script "start", port 8788).
VITE_BOT_API_URL=http://localhost:8788

# SIGMA Phase 1 "bỏ Rocket.Chat" (28/7) — Google OAuth Client ID (Sign In With Google JS SDK,
# apps.googleusercontent.com). CÙNG giá trị với GOOGLE_CLIENT_ID ở apps/bot-api/.env. Xem lib/google-signin.ts.
VITE_GOOGLE_CLIENT_ID=
